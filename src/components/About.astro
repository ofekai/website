---
import { Image } from 'astro:assets';
import SectionTitle from './SectionTitle.astro';
import IconData from '../icons/data.svg';
import IconLanguage from '../icons/language.svg';
import IconCooperate from '../icons/cooperate.svg';
import IconArrow from '../icons/arrow.svg';
import type { Messages } from '../i18n';
import logoOfekDark from '../assets/images/Logo_Ofek_o.png';

interface Props {
  messages: Messages['about'];
}

const { messages } = Astro.props;
const featureIcons = [IconData, IconLanguage, IconCooperate];
---

<section
  id="about"
  class="about-section transition-panel transition-panel-light"
  data-section
  data-transition="hero-about"
>
  <span class="transition-seam transition-seam-start" aria-hidden="true"></span>
  <div class="about-intro-band">
    <div class="container about-intro">
      <SectionTitle light={messages.titleLight} bold={messages.titleBold} />
      <div class="about-brand-mark" data-reveal="rise">
        <Image src={logoOfekDark} alt="Ofek" width={150} height={75} />
      </div>
      <p class="description" data-reveal="rise">
        {messages.description}
      </p>
    </div>
  </div>
  <div class="about-features-band" data-transition-features>
    <div class="container">
      <div class="feature-grid" data-reveal-group>
        {
          messages.features.map((feature, index) => {
            const Icon = featureIcons[index];
            return (
            <article class="feature-card" data-reveal="rise">
              <div class="feature-num">{Icon && <Icon aria-hidden="true" />}</div>
              <h3 class="feature-title">{feature.title}</h3>
              <p class="feature-label">{feature.text}</p>
            </article>
            );
          })
        }
      </div>
    </div>
  </div>
  <div class="about-scroll container">
    <a href="#consulting" aria-label={messages.scrollLabel}>
      <IconArrow class="floating-arrow" aria-hidden="true" />
    </a>
  </div>
</section>
