---
import { Image } from 'astro:assets';
import ButtonOutline from './ButtonOutline.astro';
import { site, addresses } from '../data/site';
import logoOfek from '../assets/images/Logo_Ofek.png';
import IconLocation from '../icons/location.svg';
import IconLinkedin from '../icons/linkedin.svg';
---

<footer id="contact" class="footer" data-section>
  <div class="container grid footer-grid" data-reveal-group>
    <div class="footer-brand" data-reveal="rise">
      <div class="footer-logo">
        <Image src={logoOfek} alt="Ofek" width={150} height={75} densities={[1, 2]} />
      </div>
      {
        addresses.map((address) => (
          <p class="footer-loction"><IconLocation aria-hidden="true" />{address}</p>
        ))
      }
    </div>
    <div class="footer-links-grid" data-reveal="mask">
      <h3 class="footer-header">Let&rsquo;s team up!</h3>
      <a href={`mailto:${site.email}`}>
        <span class="footer-email">Email us at {site.email}</span>
      </a>
      <ButtonOutline href={`mailto:${site.email}`} />
      <a class="footer-link-outer" target="_blank" rel="noopener noreferrer" href={site.linkedin} aria-label="Ofek on LinkedIn">
        <IconLinkedin class="icon-linkedin" aria-hidden="true" />
      </a>
    </div>
    <div class="copyright" data-reveal="line">© 2026 Ofek. All rights reserved.</div>
  </div>
</footer>
