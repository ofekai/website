---
import { Font, getImage } from 'astro:assets';
import '../styles/global.css';
import { site, addresses } from '../data/site';
import { localeOrder, locales } from '../i18n';
import type { Locale, Messages } from '../i18n';
import heroBanner from '../assets/images/Banner.png';
import logoOfek from '../assets/images/Logo_Ofek_o.png';

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages } = Astro.props;
const localeDefinition = locales[locale];
const { title, description } = messages.seo;

const canonicalURL = new URL(localeDefinition.path, Astro.site);
const alternates = localeOrder.map((alternateLocale) => ({
  ...locales[alternateLocale],
  url: new URL(locales[alternateLocale].path, Astro.site),
}));

// Both are processed here (rather than reused from the components that
// render heroBanner/logoOfek elsewhere) because these need a single static
// URL for meta tags/JSON-LD, not a responsive <Image>/<Picture>.
const ogImage = await getImage({ src: heroBanner, width: 1200, format: 'jpeg' });
const ogImageURL = new URL(ogImage.src, Astro.site);

const logoImage = await getImage({ src: logoOfek, width: 150, format: 'png' });

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  logo: new URL(logoImage.src, Astro.site).href,
  address: addresses,
  contactPoint: {
    '@type': 'ContactPoint',
    email: site.email,
    contactType: 'customer support',
  },
  sameAs: [site.linkedin],
};
---

<!doctype html>
<html
  lang={localeDefinition.htmlLang}
  dir={localeDefinition.direction}
  data-locale={locale}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {
      alternates.map(({ htmlLang, url }) => (
        <link rel="alternate" hreflang={htmlLang} href={url} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />

    {/* Set before first paint so reveal initial states never flash. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <link rel="icon" href="/images/Ofek_favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={localeDefinition.ogLocale} />
    {
      alternates
        .filter(({ ogLocale }) => ogLocale !== localeDefinition.ogLocale)
        .map(({ ogLocale }) => <meta property="og:locale:alternate" content={ogLocale} />)
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} is:inline />

    {/* `preload` is required — without it, text stays invisible on slow
        connections until the font finishes downloading. */}
    <Font
      cssVariable="--font-lato"
      preload={
        locale === 'zh-tw'
          ? [{ subset: 'latin', style: 'normal', weight: 300 }]
          : [{ subset: 'latin', style: 'normal' }]
      }
    />
    <Font
      cssVariable="--font-open-sans"
      preload={
        locale === 'zh-tw' ? false : [{ subset: 'latin', style: 'normal' }]
      }
    />

    <script>
      import '../scripts/main';
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
