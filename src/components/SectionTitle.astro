---
interface Props {
  light: string;
  bold: string;
}

const { light, bold } = Astro.props;
---

{/* The literal space between the spans is load-bearing today; `.title-bold`
    also carries margin-left. Phase 3 moves this spacing fully into CSS. */}
<div class="main-title">
  <span class="title-light">{light}</span>{' '}
  <span class="title-bold">{bold}</span>
</div>
