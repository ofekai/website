---
import ButtonOutline from './ButtonOutline.astro';
import { site, addresses } from '../data/site';
---

<footer id="contact" class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="footer-logo"><img src="/images/Logo_Ofek.png" alt="" /></div>
      {
        addresses.map((address) => (
          <p class="footer-loction"><img src="/images/ic_location.svg" alt="" />{address}</p>
        ))
      }
    </div>
    <div class="footer-links-grid">
      <h5 class="footer-header">Let&rsquo;s team up!</h5>
      <a href={`mailto:${site.email}`}>
        <span class="footer-email">Email us at {site.email}</span>
      </a>
      <ButtonOutline href={`mailto:${site.email}`} />
      <a class="footer-link-outer" target="_blank" href={site.linkedin}>
        <img src="/images/ic_linkedin.svg" alt="" />
      </a>
    </div>
  </div>
  <div class="copyright">© 2026 Ofek. All rights reserved.</div>
</footer>
