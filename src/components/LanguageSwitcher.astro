---
import IconLanguage from '../icons/language.svg';
import { localeOrder, locales } from '../i18n';
import type { Locale, Messages } from '../i18n';

interface Props {
  locale: Locale;
  messages: Messages['language'];
}

const { locale, messages } = Astro.props;
const current = locales[locale];
---

<details class="language-switcher" data-language-switcher>
  <summary aria-label={messages.select}>
    <IconLanguage aria-hidden="true" />
    <span>{current.shortLabel}</span>
    <svg class="language-chevron" viewBox="0 0 12 8" aria-hidden="true">
      <path d="M1 1.25 6 6.25l5-5" fill="none" stroke="currentColor" stroke-width="1.5"></path>
    </svg>
  </summary>
  <ul aria-label={messages.select}>
    {
      localeOrder.map((option) => {
        const definition = locales[option];
        return (
          <li>
            <a
              href={definition.path}
              lang={definition.htmlLang}
              dir={definition.direction}
              aria-label={`${messages.switchTo} ${definition.label}`}
              aria-current={option === locale ? 'page' : undefined}
              data-locale-link
            >
              {definition.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</details>
