---
import { Image } from 'astro:assets';
import { navLinks } from '../data/site';
import logoOfek from '../assets/images/Logo_Ofek.png';
import logoOfekDark from '../assets/images/Logo_Ofek_o.png';
---

<nav id="navbar" class="navbar">
  <div class="nav-progress" aria-hidden="true"><span data-scroll-progress></span></div>
  <div class="nav-container container">
    <div class="logo"><Image src={logoOfek} alt="Ofek" width={100} height={50} densities={[1, 2]} /></div>
    <div class="logo-dark">
      <Image src={logoOfekDark} alt="" aria-hidden="true" width={100} height={50} densities={[1, 2]} />
    </div>
    <button
      class="menu-toggle"
      id="menu-toggle"
      aria-label="Open Menu"
      aria-expanded="false"
      aria-controls="nav-links"
    >
      <span class="menu-icon" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </button>
    <div class="nav-links" id="nav-links">
      {navLinks.map(({ label, href }) => <a href={href}>{label}</a>)}
    </div>
  </div>
</nav>
