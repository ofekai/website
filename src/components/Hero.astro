---
import { Picture } from 'astro:assets';
import ButtonOutline from './ButtonOutline.astro';
import heroBanner from '../assets/images/Banner.png';
import IconArrow from '../icons/arrow.svg';

const headline = 'TRUSTED INSIGHTS INTO FRONTIER COMPUTE MANUFACTURING';
const lines = ['TRUSTED INSIGHTS INTO', 'FRONTIER COMPUTE MANUFACTURING'];
---

<section class="hero">
  <div class="hero-media">
    <Picture
      src={heroBanner}
      formats={['avif', 'webp']}
      fallbackFormat="png"
      widths={[640, 960, 1280, 1600, 1920, 2560]}
      sizes="100vw"
      alt=""
      aria-hidden="true"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
      data-parallax
    />
  </div>
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="container grid">
    <div class="hero-content">
      <h1 class="hero-title" aria-label={headline}>
        {lines.map((line, i) => (
          <span class:list={['hero-line', { 'hero-line-strong': i === 1 }]} aria-hidden="true">
            <span class="hero-line-in" style={`--i:${i}`}>{line}</span>
          </span>
        ))}
      </h1>
      <ButtonOutline href="#contact" />
    </div>
  </div>

  <div class="hero-scroll container">
    <a href="#about" aria-label="Scroll to About Us"><IconArrow class="floating-arrow" aria-hidden="true" /></a>
  </div>
</section>
