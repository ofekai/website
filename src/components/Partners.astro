---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionTitle from './SectionTitle.astro';
import type { Messages } from '../i18n';
import logoAnnapurna from '../assets/images/logo_Annapurna.png';
import logoHipcam from '../assets/images/logo_Hipcam.png';
import logoGoldtek from '../assets/images/logo_Goldtek.svg';
import logoAccton from '../assets/images/logo_Accton.png';
import logoInventec from '../assets/images/logo_Inventec.svg';
import logoAWS from '../assets/images/logo_AWS.svg';
// Source: Wikimedia Commons, File:USI_Logo_blue_1200x750_20230808.svg
// (CC BY-SA 3.0). Self-hosted so the page has no third-party requests.
import logoUSI from '../assets/images/logo_USI.svg';

interface Props {
  messages: Messages['partners'];
}

const { messages } = Astro.props;

// The files use very different aspect ratios and amounts of internal whitespace.
// `--logo-scale` optically normalises their visible marks inside a shared band.
type Partner = {
  alt: string;
  scale: number;
  local: ImageMetadata;
};

const partners: Partner[] = [
  { local: logoAnnapurna, alt: 'Annapurna Labs', scale: 0.98 },
  { local: logoHipcam, alt: 'Hipcam', scale: 1.05 },
  { local: logoGoldtek, alt: 'Goldtek', scale: 1.08 },
  { local: logoAccton, alt: 'Accton', scale: 1 },
  { local: logoUSI, alt: 'USI', scale: 1.05 },
  { local: logoInventec, alt: 'Inventec', scale: 1.12 },
  { local: logoAWS, alt: 'Amazon Web Services', scale: 0.88 },
];

const groups = [false, true];
---

<section
  id="partners"
  class="section partners-section transition-panel transition-panel-light"
  data-section
  data-transition="heatvision-partners"
>
  <span class="transition-seam transition-seam-start" aria-hidden="true"></span>
  <div class="container grid">
    <SectionTitle light={messages.titleLight} bold={messages.titleBold} class="partners-title" />
    <div
      class="partners-strip"
      data-reveal="line"
      role="region"
      aria-label={messages.ariaLabel}
      tabindex="0"
    >
      <div class="partners-track" data-transition-marquee>
      {
        groups.map((duplicate) => (
          <div class="partners-group" role={duplicate ? undefined : 'list'} aria-hidden={duplicate ? 'true' : undefined}>
            {partners.map((p) => (
              <div
                class="logo-item"
                role={duplicate ? undefined : 'listitem'}
                style={`--logo-scale: ${p.scale}`}
              >
                <Image src={p.local} alt={duplicate ? '' : p.alt} height={100} />
              </div>
            ))}
          </div>
        ))
      }
      </div>
    </div>
    <button
      type="button"
      class="partners-toggle"
      aria-pressed="false"
      data-partners-toggle
      data-label-pause={messages.pause}
      data-label-play={messages.play}
    >
      <svg data-icon="pause" viewBox="0 0 12 12" aria-hidden="true"><rect x="2" y="1" width="3" height="10" /><rect x="7" y="1" width="3" height="10" /></svg>
      <svg data-icon="play" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 1l9 5-9 5z" /></svg>
      <span data-partners-toggle-label>{messages.pause}</span>
    </button>
  </div>
</section>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-partners-toggle]');
  const strip = document.querySelector<HTMLElement>('.partners-strip');
  const label = toggle?.querySelector<HTMLElement>('[data-partners-toggle-label]');
  toggle?.addEventListener('click', () => {
    const paused = toggle.getAttribute('aria-pressed') !== 'true';
    toggle.setAttribute('aria-pressed', String(paused));
    strip?.classList.toggle('is-paused', paused);
    if (label) label.textContent = (paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause) ?? '';
  });
</script>
