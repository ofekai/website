---
import { Image } from 'astro:assets';
import { navLinks } from '../data/site';
import logoOfek from '../assets/images/Logo_Ofek.png';
import logoOfekDark from '../assets/images/Logo_Ofek_o.png';
---

<nav id="navbar" class="navbar">
  <div class="nav-container container">
    <div class="logo"><Image src={logoOfek} alt="Ofek" width={100} height={50} densities={[1, 2]} /></div>
    <div class="logo-dark">
      <Image src={logoOfekDark} alt="" aria-hidden="true" width={100} height={50} densities={[1, 2]} />
    </div>
    <button
      class="menu-toggle"
      id="menu-toggle"
      aria-label="Open Menu"
      aria-expanded="false"
      aria-controls="nav-links"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="icon"
        fill="currentColor"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
    <div class="nav-links" id="nav-links">
      {navLinks.map(({ label, href }) => <a href={href}>{label}</a>)}
    </div>
  </div>
</nav>
