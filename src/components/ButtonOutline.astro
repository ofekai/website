---
interface Props {
  href: string;
  label?: string;
  variant?: 'primary' | 'outline';
  tone?: 'light' | 'dark';
}

const { href, label = 'Talk to us', variant = 'outline', tone = 'light' } = Astro.props;
---

<a href={href} class:list={['btn-outline', `btn-${variant}`, `btn-${tone}`]}>
  {label}
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="btn-arrow"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    aria-hidden="true"
  >
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
  </svg>
</a>
