---
import { Image } from 'astro:assets';
import SectionTitle from './SectionTitle.astro';
import EditorialMedia from './EditorialMedia.astro';
import type { Messages } from '../i18n';
import consultingTree from '../assets/images/consulting-tree-v2.png';
import iconHeatVision from '../assets/images/heatVision.png';
import heatVisionSpi from '../assets/images/heatvision/spi-board-heatmap-core.png';
import heatVisionVolumeScale from '../assets/images/heatvision/spi-volume-scale-original.png';
import heatVisionBoardMap from '../assets/images/heatvision/board-defect-map.png';
import heatVisionAoi from '../assets/images/heatvision/aoi-sankey.png';
import heatVisionTemperature from '../assets/images/heatvision/reflow-temperature-overview.png';

interface Props {
  messages: Messages['expertise'];
}

const { messages } = Astro.props;
---

<section id="consulting" class="expertise-section" data-section>
  <div class="expertise-heading-band" data-transition-heading>
    <span class="transition-seam transition-seam-start" aria-hidden="true"></span>
    <div class="container">
    <SectionTitle light={messages.titleLight} bold={messages.titleBold} />
    </div>
  </div>

  <div class="expertise-story" data-transition-story>
  <div class="expertise-stripe consulting-stripe" data-transition-panel="consulting">
    <div class="stripe-media" data-transition-layer="media">
      <EditorialMedia
        src={consultingTree}
        alt=""
        ratio="auto"
        position="center"
        tone="natural"
        reveal="left"
        widths={[640, 960, 1280]}
        sizes="(min-width: 769px) 48vw, 100vw"
      />
    </div>
    <div class="stripe-content" data-reveal="rise" data-transition-layer="copy">
      <div>
          <h3 class="card-title consulting-title">
            <span>{messages.consultingTitleLight}</span>
            <strong>{messages.consultingTitleBold}</strong>
          </h3>
          <p class="card-text">
            {messages.consultingBody}
          </p>
      </div>
    </div>
  </div>

  <div
    id="heatVision"
    class="expertise-stripe heatvision-stripe"
    data-section
    data-transition-panel="heatvision"
  >
    <span class="heatvision-transition-edge" aria-hidden="true"></span>
    <div class="stripe-content" data-transition-layer="copy">
      <div class="service-mark">
        <Image src={iconHeatVision} alt="" aria-hidden="true" width={115} height={115} densities={[1, 2]} />
      </div>
      <div>
          <h3 class="card-title heatvision-title brand-ltr" dir="ltr">HeatVision<sup>&reg;</sup></h3>
          <p class="card-text">
            {messages.heatVisionBody}
          </p>
      </div>
    </div>
    <div class="heatvision-stage" data-transition-layer="stage" aria-hidden="true">
      <div class="heatvision-gallery">
        <figure class="heatvision-shot heatvision-shot-primary">
          <span class="heatvision-graph-label heatvision-graph-label-primary">
            {messages.heatVisionGraphLabels.surfaceMountTechnology}
          </span>
          <div class="heatvision-primary-composition">
            <Image
              class="heatvision-primary-chart"
              src={heatVisionSpi}
              alt=""
              widths={[640, 960, 1280, 1920, 2560]}
              sizes="(min-width: 869px) 46vw, (min-width: 521px) 82vw, 82vw"
              loading="lazy"
            />
            <Image
              class="heatvision-primary-scale"
              src={heatVisionVolumeScale}
              alt=""
              widths={[64, 136]}
              sizes="(min-width: 869px) 3vw, 8vw"
              loading="lazy"
            />
          </div>
        </figure>
        <span class="heatvision-gallery-separator"></span>
        <div class="heatvision-support-rail">
          <figure class="heatvision-shot heatvision-shot-support heatvision-shot-unified-bg">
            <span class="heatvision-graph-label">
              {messages.heatVisionGraphLabels.pickAndPlace}
            </span>
            <Image
              src={heatVisionBoardMap}
              alt=""
              widths={[320, 480, 640]}
              sizes="(min-width: 869px) 18vw, (min-width: 521px) 31vw, 88vw"
              loading="lazy"
            />
          </figure>
          <span class="heatvision-rail-separator"></span>
          <figure class="heatvision-shot heatvision-shot-support">
            <span class="heatvision-graph-label">
              {messages.heatVisionGraphLabels.automaticOpticalInspection}
            </span>
            <Image
              src={heatVisionAoi}
              alt=""
              widths={[320, 480, 640, 960]}
              sizes="(min-width: 869px) 18vw, (min-width: 521px) 31vw, 88vw"
              loading="lazy"
            />
          </figure>
          <span class="heatvision-rail-separator"></span>
          <figure class="heatvision-shot heatvision-shot-support heatvision-shot-unified-bg">
            <span class="heatvision-graph-label">
              {messages.heatVisionGraphLabels.reflow}
            </span>
            <Image
              src={heatVisionTemperature}
              alt=""
              widths={[320, 480, 640, 960]}
              sizes="(min-width: 869px) 18vw, (min-width: 521px) 31vw, 88vw"
              loading="lazy"
            />
          </figure>
        </div>
      </div>
    </div>
  </div>
  </div>
</section>
