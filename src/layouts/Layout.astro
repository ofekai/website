---
import { Font, getImage } from 'astro:assets';
import '../styles/global.css';
import { site, addresses } from '../data/site';
import { localeOrder, locales } from '../i18n';
import type { Locale, Messages } from '../i18n';
import logoOfek from '../assets/images/Logo_Ofek_o.png';
import ogEn from '../assets/images/og/og-en.jpg';
import ogZhTw from '../assets/images/og/og-zh-tw.jpg';

// Branded link-preview cards, generated by scripts/make-og.mjs.
const ogImages = { en: ogEn, 'zh-tw': ogZhTw } as const;

interface Props {
  locale: Locale;
  messages: Messages;
  /** Error pages: no canonical, alternates or og:url, and kept out of the index. */
  noindex?: boolean;
}

const { locale, messages, noindex = false } = Astro.props;
const localeDefinition = locales[locale];
const { title, description } = messages.seo;

const canonicalURL = new URL(localeDefinition.path, site.canonicalUrl);
const alternates = localeOrder.map((alternateLocale) => ({
  ...locales[alternateLocale],
  url: new URL(locales[alternateLocale].path, site.canonicalUrl),
}));

// Both are processed here (rather than reused from the components that
// render heroBanner/logoOfek elsewhere) because these need a single static
// URL for meta tags/JSON-LD, not a responsive <Image>/<Picture>.
const ogImage = await getImage({ src: ogImages[locale], width: 1200, height: 630, format: 'jpeg' });
const ogImageURL = new URL(ogImage.src, Astro.site);

const logoImage = await getImage({ src: logoOfek, width: 150, format: 'png' });

const organizationId = `${site.canonicalUrl}/#organization`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: site.name,
      url: site.canonicalUrl,
      logo: new URL(logoImage.src, Astro.site).href,
      description,
      foundingDate: site.foundingDate,
      address: addresses,
      contactPoint: {
        '@type': 'ContactPoint',
        email: site.email,
        contactType: 'sales',
        availableLanguage: ['English', 'Chinese'],
      },
      sameAs: [site.linkedin],
    },
    {
      '@type': 'WebSite',
      '@id': `${site.canonicalUrl}/#website`,
      url: site.canonicalUrl,
      name: site.name,
      inLanguage: localeDefinition.htmlLang,
      publisher: { '@id': organizationId },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'HeatVision',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      description: messages.expertise.heatVisionBody,
      inLanguage: localeDefinition.htmlLang,
      publisher: { '@id': organizationId },
    },
  ],
};
---

<!doctype html>
<html
  lang={localeDefinition.htmlLang}
  dir={localeDefinition.direction}
  data-locale={locale}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    {
      !noindex &&
        alternates.map(({ htmlLang, url }) => (
          <link rel="alternate" hreflang={htmlLang} href={url} />
        ))
    }
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL('/', site.canonicalUrl)} />}

    {/* Set before first paint so reveal initial states never flash. */}
    <script is:inline>
      document.documentElement.classList.add('js');
      /* If the module never runs (blocked, failed, ancient browser), drop back
         to the no-JS styles so [data-reveal] content cannot stay hidden. */
      setTimeout(function () {
        var root = document.documentElement;
        if (!root.classList.contains('js-ready')) root.classList.remove('js');
      }, 4000);
    </script>

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="theme-color" content="#141719" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={localeDefinition.ogLocale} />
    {
      alternates
        .filter(({ ogLocale }) => ogLocale !== localeDefinition.ogLocale)
        .map(({ ogLocale }) => <meta property="og:locale:alternate" content={ogLocale} />)
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={title} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    {/* `preload` is required — without it, text stays invisible on slow
        connections until the font finishes downloading. */}
    <Font
      cssVariable="--font-lato"
      preload={
        locale === 'zh-tw'
          ? [{ subset: 'latin', style: 'normal', weight: 300 }]
          : [
              // The hero's two weights; 400 is only used below the fold.
              { subset: 'latin', style: 'normal', weight: 300 },
              { subset: 'latin', style: 'normal', weight: 700 },
            ]
      }
    />
    <Font
      cssVariable="--font-open-sans"
      preload={
        locale === 'zh-tw' ? false : [{ subset: 'latin', style: 'normal' }]
      }
    />

    <script>
      import '../scripts/main';
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{messages.menu.skipToContent}</a>
    <slot />
  </body>
</html>
