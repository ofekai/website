---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Expertise from './Expertise.astro';
import Partners from './Partners.astro';
import Footer from './Footer.astro';
import { getMessages } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const messages = getMessages(locale);
---

<Layout locale={locale} messages={messages}>
  <Nav locale={locale} messages={messages} />
  {/*
    The .scene-seam spans are the view-timeline subjects for every
    section-to-section transition. They sit between scenes so they are never
    descendants of a pinned box -- see the .scene-seam comment in global.css.
  */}
  <main>
    <Hero messages={messages.hero} />
    <span class="scene-seam" data-seam="hero-about" aria-hidden="true"></span>
    <About messages={messages.about} />
    <span class="scene-seam" data-seam="about-expertise" aria-hidden="true"></span>
    <Expertise messages={messages.expertise} />
    <span class="scene-seam" data-seam="heatvision-partners" aria-hidden="true"></span>
    <Partners messages={messages.partners} />
  </main>
  <Footer messages={messages.footer} />
</Layout>
