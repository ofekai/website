---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Ofek' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    {/* Set before first paint so reveal initial states never flash. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <link rel="icon" href="/images/Ofek_favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,700;0,900;1,400;1,700&display=swap"
      rel="stylesheet"
    />

    <script>
      import '../scripts/main';
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
