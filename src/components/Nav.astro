---
import { Image } from 'astro:assets';
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { Locale, Messages } from '../i18n';
import logoOfek from '../assets/images/Logo_Ofek_o.png';

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages } = Astro.props;
const navLinks = [
  { label: messages.nav.about, href: '#about' },
  { label: messages.nav.consulting, href: '#consulting' },
  { label: messages.nav.heatVision, href: '#heatVision' },
  { label: messages.nav.partners, href: '#partners' },
  { label: messages.nav.contact, href: '#contact' },
];
---

<nav id="navbar" class="navbar">
  <div class="nav-progress" aria-hidden="true"><span data-scroll-progress></span></div>
  <div class="nav-container container">
    <div class="logo">
      <Image src={logoOfek} alt="Ofek" width={150} height={75} format="png" />
      <span
        class="logo-tip"
        style={`--logo-mask: url("${logoOfek.src}")`}
        aria-hidden="true"
      ></span>
    </div>
    <button
      class="menu-toggle"
      id="menu-toggle"
      aria-label={messages.menu.open}
      data-label-open={messages.menu.open}
      data-label-close={messages.menu.close}
      aria-expanded="false"
      aria-controls="nav-links"
    >
      <span class="menu-icon" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </button>
    <div class="nav-links" id="nav-links">
      {navLinks.map(({ label, href }) => <a href={href}>{label}</a>)}
      <LanguageSwitcher locale={locale} messages={messages.language} />
    </div>
  </div>
</nav>
