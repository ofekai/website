---
import { getImage } from 'astro:assets';
import { site } from '../data/site';
import type { Messages } from '../i18n';
import logoOfek from '../assets/images/Logo_Ofek_o.png';
import IconLocation from '../icons/location.svg';
import IconLinkedin from '../icons/linkedin.svg';
import IconMail from '../icons/mail.svg';

interface Props {
  messages: Messages['footer'];
}

const { messages } = Astro.props;
// Same transform as Nav.astro, so the browser fetches it once.
const logo = await getImage({ src: logoOfek, width: 150, format: 'webp' });
---

<footer
  id="contact"
  class="footer transition-panel transition-panel-dark"
  data-section
>
  <span class="transition-seam transition-seam-end" aria-hidden="true"></span>
  <div class="container footer-container" data-reveal-group>
    <div class="footer-main">
      <div class="footer-brand" data-reveal="rise">
        <div class="footer-logo">
          <img src={logo.src} alt="Ofek" width="150" height="75" loading="lazy" decoding="async" />
          <span
            class="logo-tip"
            style={`--logo-mask: url("${logo.src}")`}
            aria-hidden="true"
          ></span>
        </div>
        <div class="footer-addresses">
          {
            messages.offices.map(({ office, address, addressDirection }) => (
              <div class="footer-location">
                <span class="footer-location-icon"><IconLocation aria-hidden="true" /></span>
                <p>
                  <span class="footer-office">{office}</span>
                  <span dir={addressDirection}>{address}</span>
                </p>
              </div>
            ))
          }
        </div>
      </div>
      <div class="footer-contact" data-reveal="mask">
        <p class="footer-kicker">{messages.kicker}</p>
        <h2 class="footer-header">
          <span>{messages.headingLight}</span>
          <strong>{messages.headingBold}</strong>
        </h2>
        <p class="footer-email-line">
          <span class="footer-email" id="footer-email">{messages.emailPrefix} <bdi data-copy-source>{site.email}</bdi></span>
          <button
            type="button"
            class="footer-copy-button"
            aria-describedby="footer-email"
            data-copy={site.email}
            data-label-copy={messages.copyEmail}
            data-label-copied={messages.emailCopied}
          >{messages.copyEmail}</button>
          <span class="footer-copy-status" aria-live="polite" data-copy-status></span>
        </p>
        <div class="footer-actions">
          <a class="footer-mail-button" href={`mailto:${site.email}`}>
            <span>{messages.contactButton}</span>
            <IconMail aria-hidden="true" />
          </a>
          <a class="footer-link-outer" target="_blank" rel="noopener noreferrer" href={site.linkedin} aria-label={messages.linkedInLabel}>
            <IconLinkedin class="icon-linkedin" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
    <div class="copyright" data-reveal="line">{messages.copyright(new Date().getFullYear())}</div>
  </div>
</footer>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('.footer-copy-button');
  const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]');
  const copySource = document.querySelector<HTMLElement>('[data-copy-source]');
  let resetTimer = 0;

  // Clipboard unavailable or denied: select the address so it can be copied by hand.
  const selectAddress = () => {
    if (!copySource) return;
    const range = document.createRange();
    range.selectNodeContents(copySource);
    const selection = window.getSelection();
    selection?.removeAllRanges();
    selection?.addRange(range);
  };

  copyButton?.addEventListener('click', async () => {
    const { copy = '', labelCopy = '', labelCopied = '' } = copyButton.dataset;
    try {
      await navigator.clipboard.writeText(copy);
    } catch {
      selectAddress();
      return;
    }
    copyButton.textContent = labelCopied;
    if (copyStatus) copyStatus.textContent = labelCopied;
    clearTimeout(resetTimer);
    resetTimer = window.setTimeout(() => {
      copyButton.textContent = labelCopy;
      if (copyStatus) copyStatus.textContent = '';
    }, 2000);
  });
</script>
