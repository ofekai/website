---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  ratio?: 'landscape' | 'portrait' | 'square' | 'auto';
  position?: string;
  tone?: 'mono' | 'natural';
  reveal?: 'left' | 'right' | 'up' | 'none';
  widths?: number[];
  sizes?: string;
  priority?: boolean;
}

const {
  src,
  alt,
  ratio = 'landscape',
  position = 'center',
  tone = 'mono',
  reveal = 'up',
  widths = [480, 720, 960, 1280],
  sizes = '(min-width: 769px) 50vw, 100vw',
  priority = false,
} = Astro.props;
---

<figure
  class:list={['editorial-media', `media-${ratio}`, `media-${tone}`, `media-reveal-${reveal}`]}
  data-reveal={reveal === 'none' ? undefined : 'mask'}
  style={`--media-position:${position}`}
>
  <Picture
    src={src}
    formats={['avif', 'webp']}
    fallbackFormat="png"
    widths={widths}
    sizes={sizes}
    alt={alt}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
  />
</figure>
